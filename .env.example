# ==============================================================================
# NEXZORA Environmental Configuration Template
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=./data/nexzora.db

# JWT Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Verification Configuration
# Options: 'development' (logs OTP to server console/test mode) or 'production' (SMTP / SMS gateway)
OTP_PROVIDER=development
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5

# ==============================================================================
# SMTP Email Configuration (Nodemailer)
# Used for Email OTP Verification & Password Recovery Code Delivery
# ==============================================================================
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_digit_app_password (Generate from Google Account -> Security -> App passwords)
#   SMTP_FROM="NEXZORA Landslide Alert" <your_email@gmail.com>
#
# For custom SMTP server:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=alerts@yourdomain.com
#   SMTP_PASS=your_smtp_password
#   SMTP_FROM="NEXZORA Early Warning" <alerts@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEXZORA Disaster Early Warning" <noreply@nexzora.gov.in>
SMTP_SERVICE=

# Production SMS Gateway Configuration (e.g., Twilio / Fast2SMS / CDAC SMS Gateway)
SMS_API_KEY=
SMS_SENDER_ID=NEXZOR

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
