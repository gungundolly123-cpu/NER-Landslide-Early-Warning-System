# ==============================================================================
# NEXZORA Environmental Configuration Template
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=./data/nexzora.db

# JWT Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Verification Configuration
# Options: 'development' (logs masked OTP to server console/test mode) or 'production' (SMS gateway)
OTP_PROVIDER=development
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5

# Production SMS Gateway Configuration (e.g., Twilio / Fast2SMS / CDAC SMS Gateway)
SMS_API_KEY=
SMS_SENDER_ID=NEXZOR

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
